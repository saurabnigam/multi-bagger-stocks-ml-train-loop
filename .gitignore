venv/
__pycache__/

.DS_Store
*.log
*.metadata.json
.coverage
.pytest_cache/

# The state database is derived, not committed: the record is data/ledger (committed, gzip
# partitions). Rebuild with `python -m quant db rebuild --output quant.db`. quant_engine.db stays tracked.
quant.db
quant.db.lock
# Its write-ahead/shared-memory files are transient SQLite state. Do NOT add data/ledger here:
# it is the committed record (MASTER_SPEC 4.2).
quant.db-wal
quant.db-shm
*.db-wal
*.db-shm

# Local prices cache, source archive and run logs/locks: large or
# machine-specific, and reproducible from data/ledger + a fresh capture.
data/prices_daily.sqlite*
data/archive/
# Human-attached document bodies (triage attach --file): private, content-addressed, hash-only in the
# archived envelope. Already covered by data/archive/ above; kept explicit so narrowing that rule
# cannot publish them by accident (docs/operations/triage.md).
data/archive/triage_private/
data/logs/
data/.locks/
.cache/
*.lock

# Local settings for scripts/capture_routine.sh and scripts/backup_state.sh (docs/operations/month_end.md)
routine.env
